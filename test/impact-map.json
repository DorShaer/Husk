{
  "version": 1,
  "comment": "Which e2e specs a change can reach. Read by scripts/select-e2e.js. Tokens are the class, id, page and IPC-channel prefixes this codebase already names things with, so one edit to a .ag- rule resolves to the Agents specs. Anything not described here falls back to the full suite on purpose: under-selecting hides a regression, over-selecting only costs time. CI still runs everything, which is what catches drift in this file.",
  "alwaysRun": [
    "smoke.spec.js",
    "lifecycle.spec.js"
  ],
  "fullSuiteWhenChanged": [
    "package.json",
    "package-lock.json",
    "src/preload.js",
    "src/renderer/vendor",
    "scripts/lib/test-impact.js",
    "test/impact-map.json"
  ],
  "tokenScannedPaths": [
    "src/main.js",
    "src/renderer/app.js",
    "src/renderer/index.html",
    "src/renderer/styles.css"
  ],
  "maxAreas": 3,
  "sharedTokens": [
    "modal",
    "btn",
    "ghost",
    "form",
    "page",
    "rail",
    "toast",
    "es",
    "empty",
    "iconbtn",
    "kbd",
    "husk",
    "topbar",
    "ctx",
    "tt"
  ],
