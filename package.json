{
  "name": "husk",
  "version": "0.3.4",
  "description": "A desktop home for your CLI agent. Wraps claude / copilot / codex / aider in a clean Electron window with a real PTY, MCP integration, drag-drop context, sessions, voice, and a live status panel.",
  "main": "src/main.js",
  "license": "MIT",
  "author": "Dor Shaer",
  "homepage": "https://github.com/DorShaer/Husk",
  "repository": {
    "type": "git",
    "url": "https://github.com/DorShaer/Husk.git"
  },
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.3",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.husk.app",
    "productName": "Husk",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "!**/node_modules/.cache/**/*",
      "!**/*.{md,iml,ts,map,test.js}",
      "!**/.DS_Store",
      "!**/.eslintrc*",
      "!**/.gitignore",
      "!**/CHANGELOG*"
    ],
    "extraResources": [
      {
        "from": "libs/pai",
        "to": "pai",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "installer",
        "to": "installer",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "icon": "installer/husk-icon.png",
      "synopsis": "Desktop home for CLI AI agents",
      "description": "Husk wraps claude / copilot / codex / aider in a clean Electron window with a real PTY, MCP integration, drag-drop file context, sessions, and voice.",
      "maintainer": "DorShaer <kassofer@gmail.com>"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "installer/husk-icon.png",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "installer/husk-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Husk"
    },
    "appImage": {
      "license": "LICENSE"
    },
    "publish": {
      "provider": "github",
      "owner": "DorShaer",
      "repo": "Husk"
    }
  }
}
