{
  "name": "husk",
  "version": "2.8.8",
  "description": "A desktop home for your CLI agent. Wraps claude / copilot / codex / aider in a clean Electron window with a real PTY, MCP integration, drag-drop context, sessions, voice, and a live status panel.",
  "main": "src/main.js",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "Dor Shaer",
  "homepage": "https://github.com/DorShaer/Husk",
  "repository": {
    "type": "git",
    "url": "https://github.com/DorShaer/Husk.git"
  },
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never -c.productName=husk",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "test": "node --test test/unit/",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "test:perf": "playwright test --config playwright.perf.config.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "drawflow": "^0.0.60",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.61.1",
    "electron": "^41.10.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.61.1"
  },
  "build": {
    "appId": "com.husk.app",
    "productName": "Husk",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "!**/node_modules/.cache/**/*",
      "!**/*.{md,iml,ts,map,test.js}",
      "!**/.DS_Store",
      "!**/.eslintrc*",
      "!**/.gitignore",
      "!**/CHANGELOG*"
    ],
    "extraResources": [
      {
        "from": "libs/pai",
        "to": "pai",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "installer",
        "to": "installer",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "icon": "installer/husk-icon.png",
      "synopsis": "Desktop home for CLI AI agents",
      "description": "Husk wraps claude / copilot / codex / aider in a clean Electron window with a real PTY, MCP integration, drag-drop file context, sessions, and voice.",
      "maintainer": "DorShaer <85877103+DorShaer@users.noreply.github.com>",
      "artifactName": "${name}-v${version}-linux-${arch}.${ext}",
      "executableName": "husk",
      "desktop": {
        "entry": {
          "Name": "Husk",
          "StartupWMClass": "husk"
        }
      }
    },
    "deb": {
      "afterInstall": "installer/after-install.sh",
      "afterRemove": "installer/after-remove.sh",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "installer/husk-icon.png",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "${name}-v${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "installer/husk-icon.png",
      "artifactName": "${name}-v${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Husk"
    },
    "appImage": {
      "license": "LICENSE"
    },
    "publish": {
      "provider": "github",
      "owner": "DorShaer",
      "repo": "Husk"
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret",
        "alsa-lib"
      ]
    },
    "dmg": {
      "title": "Husk"
    }
  },
  "desktopName": "husk.desktop"
}
